# Secrets and host-specific environment variables
.env
*.env.local
.*token
*.token


# Persistent container configs, databases, logs, and caches
data/*
!data/homeassistant/
data/homeassistant/*
!data/homeassistant/custom_components/
!data/homeassistant/custom_components/**
data/homeassistant/custom_components/**/__pycache__/
logs/
.venv/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Temporary and backup files
*.bk
*.bak
*.tmp
*.swp
*.swo
.DS_Store

# Arduino and ESP32 firmware build cache and local secrets
stacks/iot/firmware/**/config.h
build/
.cache/


