# Shared host settings
TZ=Asia/Kolkata
PUID=1000
PGID=1000

# Glance dashboard secret token
GLANCE_SECRET_TOKEN=change_me

# Jellyfin media library path (stored on USB HDD mounted at /mnt/hdd)
JELLYFIN_MEDIA_DIR=/mnt/hdd/jellyfin/media

# Watchtower auto-update schedule (6-field cron: sec min hour day month weekday)
# Default: check and update daily at 04:00 AM
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Glance one-click container updater service
UPDATER_PORT=9911
UPDATER_TOKEN=change_me_random_hex

# Jellyfin auto-sorter & library refresh
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=your_jellyfin_api_key

# IoT Stack: MQTT & InfluxDB configuration for flask_app
MQTT_USER=homepi
MQTT_PASSWORD=mqtt@homepi
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=homepi_token124
INFLUX_ORG=homeiot
INFLUX_BUCKET=SENSORS

