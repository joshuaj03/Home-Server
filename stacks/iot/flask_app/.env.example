# ==============================================================================
# IoT Flask App Configuration Example
# ==============================================================================
# Copy this file to .env in this folder or configure variables in root HomeServer .env

# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=False

# Mosquitto MQTT Broker Configuration
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=homepi
MQTT_PASSWORD=mqtt@homepi
MQTT_KEEPALIVE=60

# MQTT Topics to subscribe to
MQTT_TOPIC_TEMP=home/dht11/temperature
MQTT_TOPIC_HUM=home/dht11/humidity

# InfluxDB 2.x Configuration
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=homepi_token124
INFLUX_ORG=homeiot
INFLUX_BUCKET=SENSORS

