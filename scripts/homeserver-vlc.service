[Unit]
Description=VLC Telnet Audio Daemon for JBL Clip 3
After=sound.target pipewire.service
Wants=sound.target

[Service]
Type=simple
User=jake
Group=jake
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="PULSE_SERVER=unix:/run/user/1000/pulse/native"
Environment="VLC_TELNET_PORT=4212"
Environment="VLC_TELNET_PASSWORD=jbl_speaker_secret_2026"
EnvironmentFile=-/home/jake/HomeServer/.env
ExecStart=/usr/bin/cvlc -I dummy -I telnet --telnet-port ${VLC_TELNET_PORT} --telnet-password ${VLC_TELNET_PASSWORD} --aout pulse --network-caching=2000 --file-caching=1000 --live-caching=1000 --disc-caching=1000 --sout-mux-caching=2000 --audio-resampler=soxr --no-drop-late-frames --no-skip-frames
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
